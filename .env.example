# Copy to .env and fill in. NEVER commit .env.

# n8n. Must be the key your n8n data volume was created with. Never change it afterwards.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Los_Angeles

# Agent service
ANTHROPIC_API_KEY=
# Re-run the ATO and CDR known-answer cases through the service after changing the model.
ANTHROPIC_MODEL=claude-sonnet-5
# Shared secret n8n sends in the X-Service-Token header. Generate one (see README).
SERVICE_SHARED_SECRET=
LOG_LEVEL=INFO

# Deck service (shares ANTHROPIC_API_KEY, ANTHROPIC_MODEL and SERVICE_SHARED_SECRET above). Optional, defaults shown.
# DECK_MAX_REPAIRS=2     repair rounds when the automated layout checks fail
# DECK_MAX_CALLS=6       hard cap on model calls for one deck; stops a runaway run
# DECK_MAX_TOKENS=20000  per-call output limit (the SDK refuses more without streaming)
