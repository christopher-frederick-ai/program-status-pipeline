                "property": "pptx"
              },
              {
                "property": "pdf"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        2040,
        -190
      ],
      "id": "bf5e27e6-2d2c-508a-88de-9ad0fbdff54f",
      "name": "Send to distribution"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Config').first().json.reviewer_email }}",
        "subject": "=C2 weekly deck {{ $('Config').first().json.date }}: notice",
        "emailType": "text",
        "message": "=Sent the {{ $('Config').first().json.date }} deck to the distribution list exactly as drafted ({{ $('Build deck').first().json.files.pptx }}).",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        2260,
        -190
      ],
      "id": "b3a52708-b7f0-57e7-9f91-f7d0679b05d5",
      "name": "Email: sent"
    }
