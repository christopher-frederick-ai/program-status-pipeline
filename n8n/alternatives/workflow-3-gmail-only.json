              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "56473c56-3ac6-5276-9fa0-85dfb154a4b2",
              "leftValue": "={{ $('Config').first().json.distro_emails }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1380,
        -100
      ],
      "id": "bd67974b-8f6d-5243-a773-de119431bb4a",
