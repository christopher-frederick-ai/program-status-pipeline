        "message": "=Test mode: you approved, but distribution is disabled or the list is empty in the Config node. Nothing was sent.",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1600,
        40
      ],
      "id": "381882b8-d594-557f-9f2a-d68b2acdbd38",
      "name": "Email: test mode"
    },
    {
      "parameters": {
        "fileSelector": "={{ $('Build deck').first().json.files.pptx }}",
        "options": {
          "dataPropertyName": "pptx"
        }
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1600,
        -260
      ],
      "id": "9182d11e-8996-5407-b56a-937696b54a8a",
      "name": "Read release pptx"
    },
    {
      "parameters": {
        "fileSelector": "={{ $('Build deck').first().json.files.pdf }}",
        "options": {
          "dataPropertyName": "pdf"
        }
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1600,
        -120
      ],
      "id": "71da92ea-b033-5f24-85be-b4ee9d8dadfb",
      "name": "Read release pdf"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1820,
        -190
      ],
      "id": "1196d44c-15d2-5fb5-95e9-d910c5563c09",
      "name": "Merge release files"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Config').first().json.distro_emails }}",
        "subject": "=C2 Weekly Leadership Deck {{ $('Config').first().json.date }}",
        "emailType": "text",
        "message": "=Attached is the weekly leadership summary deck for {{ $('Config').first().json.date }} (PowerPoint and PDF).",
        "options": {
